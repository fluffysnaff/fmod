{
  "schemaVersion": 1,
  "id": "fmod",
  "version": "${version}",

  "name": "FMod",
  "license": "GPL-3.0-only",
  "description": "Stash hunting, route and flight helpers, coordinate hiding, and utilities for Meteor Client.",
  "authors": [
    "fluffysnaff"
  ],
  "contact": {
    "sources": "https://github.com/fluffysnaff/fmod",
    "issues": "https://github.com/fluffysnaff/fmod/issues"
  },
  "icon": "assets/template/icon.PNG",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "addon.fmod.FMod"
    ]
  },
  "mixins": [
    "fmod.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25"
  },
  "depends": {
    "java": ">=${java_version}",
    "fabricloader": ">=${loader_version}",
    "minecraft": ["${mc_version}"],
    "meteor-client": ">=26.3-0 <26.4"
  }
}
